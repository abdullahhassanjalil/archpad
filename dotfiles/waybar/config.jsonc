[
    {
        "layer": "top",
        "output": "DP-7",
        "position": "top",
        "height": 32,
        "spacing": 4,
        "modules-left": [
            "custom/launcher",
            "hyprland/workspaces#dp7",
            "hyprland/window"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "idle_inhibitor",
            "pulseaudio",
            "network",
            "cpu",
            "memory",
            "tray",
            "custom/power"
        ],
        "custom/launcher": {
            "format": "\udb82\udcc7",
            "tooltip": false,
            "on-click": "rofi -show drun"
        },
        "hyprland/workspaces#dp7": {
            "disable-scroll": true,
            "all-outputs": false,
            "warp-on-scroll": false,
            "persistent-workspaces": {
                "7": [
                    "DP-7"
                ],
                "8": [
                    "DP-7"
                ],
                "9": [
                    "DP-7"
                ]
            },
            "format": "{name}",
            "format-icons": {
                "urgent": "",
                "active": "",
                "default": ""
            }
        },
        "hyprland/window": {
            "max-length": 50,
            "separate-outputs": true
        },
        "clock": {
            "format": " {:%H:%M}",
            "format-alt": " {:%a %d %b %Y}",
            "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
        },
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
                "activated": "\udb81\udcb3",
                "deactivated": "\udb81\udcb2"
            }
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-bluetooth": "\udb80\udcb0 {volume}%",
            "format-bluetooth-muted": "\udb80\udcb2",
            "format-muted": "\udb81\udf5f",
            "format-source": " {volume}%",
            "format-source-muted": "",
            "format-icons": {
                "headphone": "\udb80\udecb",
                "hands-free": "\udb86\udc52",
                "headset": "\udb80\udece",
                "phone": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    "",
                    ""
                ]
            },
            "on-click": "pavucontrol"
        },
        "network": {
            "format-wifi": "\udb82\udd28 {essid} ({signalStrength}%)",
            "format-ethernet": "\udb80\ude00 {ipaddr}",
            "format-linked": "\udb80\ude02 {ifname} (No IP)",
            "format-disconnected": "\udb82\udd2d Disconnected",
            "format-alt": "\udb82\udd28 {ipaddr}/{cidr}",
            "tooltip-format": "{ifname}: {ipaddr}\n{gwaddr} via {essid}",
            "on-click-right": "nm-connection-editor"
        },
        "cpu": {
            "format": " {usage}%",
            "tooltip": true,
            "interval": 2
        },
        "memory": {
            "format": " {percentage}%",
            "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
            "interval": 2
        },
        "tray": {
            "spacing": 8
        },
        "custom/power": {
            "format": "\u23fb",
            "tooltip": false,
            "on-click": "wlogout -b 3 -c 10 -r 10 --layout ~/.config/wlogout/layout --css ~/.config/wlogout/style.css"
        }
    },
    {
        "layer": "top",
        "output": "DP-5",
        "position": "top",
        "height": 32,
        "spacing": 4,
        "modules-left": [
            "custom/launcher",
            "hyprland/workspaces#dp5",
            "hyprland/window"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "idle_inhibitor",
            "pulseaudio",
            "network",
            "power-profiles-daemon",
            "cpu",
            "memory",
            "temperature",
            "tray",
            "custom/power"
        ],
        "custom/launcher": {
            "format": "\udb82\udcc7",
            "tooltip": false,
            "on-click": "rofi -show drun"
        },
        "hyprland/workspaces#dp5": {
            "disable-scroll": true,
            "all-outputs": false,
            "warp-on-scroll": false,
            "persistent-workspaces": {
                "4": [
                    "DP-5"
                ],
                "5": [
                    "DP-5"
                ],
                "6": [
                    "DP-5"
                ]
            },
            "format": "{name}",
            "format-icons": {
                "urgent": "",
                "active": "",
                "default": ""
            }
        },
        "hyprland/window": {
            "max-length": 50,
            "separate-outputs": true
        },
        "clock": {
            "format": " {:%H:%M}",
            "format-alt": " {:%a %d %b %Y}",
            "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
        },
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
                "activated": "\udb81\udcb3",
                "deactivated": "\udb81\udcb2"
            }
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-bluetooth": "\udb80\udcb0 {volume}%",
            "format-bluetooth-muted": "\udb80\udcb2",
            "format-muted": "\udb81\udf5f",
            "format-source": " {volume}%",
            "format-source-muted": "",
            "format-icons": {
                "headphone": "\udb80\udecb",
                "hands-free": "\udb86\udc52",
                "headset": "\udb80\udece",
                "phone": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    "",
                    ""
                ]
            },
            "on-click": "pavucontrol"
        },
        "network": {
            "format-wifi": "\udb82\udd28 {essid} ({signalStrength}%)",
            "format-ethernet": "\udb80\ude00 {ipaddr}",
            "format-linked": "\udb80\ude02 {ifname} (No IP)",
            "format-disconnected": "\udb82\udd2d Disconnected",
            "format-alt": "\udb82\udd28 {ipaddr}/{cidr}",
            "tooltip-format": "{ifname}: {ipaddr}\n{gwaddr} via {essid}",
            "on-click-right": "nm-connection-editor"
        },
        "power-profiles-daemon": {
            "format": "{icon}",
            "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
            "tooltip": true,
            "format-icons": {
                "default": "\udb86\ude88",
                "performance": "\udb80\ude38",
                "balanced": "",
                "power-saver": "\udb83\udf86"
            }
        },
        "cpu": {
            "format": " {usage}%",
            "tooltip": true,
            "interval": 2
        },
        "memory": {
            "format": " {percentage}%",
            "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
            "interval": 2
        },
        "temperature": {
            "thermal-zone": 0,
            "critical-threshold": 85,
            "format": " {temperatureC}\u00b0C",
            "format-critical": " {temperatureC}\u00b0C",
            "tooltip": false
        },
        "tray": {
            "spacing": 8
        },
        "custom/power": {
            "format": "\u23fb",
            "tooltip": false,
            "on-click": "wlogout -b 3 -c 10 -r 10 --layout ~/.config/wlogout/layout --css ~/.config/wlogout/style.css"
        }
    }
]